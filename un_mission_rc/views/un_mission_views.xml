<odoo>

    <record id="view_un_mission_list" model="ir.ui.view">
        <field name="name">un.mission.list</field>
        <field name="model">un.mission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="un_mission_period"/>
            </list>
        </field>
    </record>

    <record id="view_un_mission_form" model="ir.ui.view">
        <field name="name">un.mission.form</field>
        <field name="model">un.mission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="un_mission_period"/>
                    </group>

                    <notebook>
                        <page string="RC Categories">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="category_id"/>
                                    <field name="limit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_un_mission" model="ir.actions.act_window">
        <field name="name">UN Missions</field>
        <field name="res_model">un.mission</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>