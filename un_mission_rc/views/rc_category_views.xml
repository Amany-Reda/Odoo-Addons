<odoo>

    <record id="view_rc_category_tree" model="ir.ui.view">
        <field name="name">rc.category.tree</field>
        <field name="model">rc.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="uom_id"/>
            </list>
        </field>
    </record>

    <record id="view_rc_category_form" model="ir.ui.view">
        <field name="name">rc.category.form</field>
        <field name="model">rc.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="uom_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rc_category" model="ir.actions.act_window">
        <field name="name">RC Category</field>
        <field name="res_model">rc.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="product_template_form_rc_category" model="ir.ui.view">
        <field name="name">product.template.form.rc.category</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="rc_category_id"/>
            </xpath>

        </field>
    </record>

</odoo>