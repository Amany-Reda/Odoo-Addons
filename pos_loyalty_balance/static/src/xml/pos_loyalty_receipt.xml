<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <xpath expr="//div[contains(@class,'gap-2') and contains(@class,'flex-row')]" position="before">
            <t t-if="order.loyalty_points">
                <br/>
                <div>
                    <strong>eWallet Balance: </strong>
                    <span><t t-esc="formatCurrency(order.loyalty_points_formatted)"/></span><br/>
<!--                    <span><t t-esc="formatCurrency(order.loyalty_points)"/></span><br/>-->
<!--                     <span><t t-esc="order.loyalty_points_currency"/></span>-->
                </div>
            </t>
        </xpath>

    </t>

</templates>